{
  "expo": {
    "name": "Mr LAD",
    "slug": "lad-app-2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "automatic",
    "privacy": "public",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.company.mrlad",
      "buildNumber": "1.0.0",
      "icon": "./assets/images/icon.png",
      "userInterfaceStyle": "automatic",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIViewControllerBasedStatusBarAppearance": true,
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Allow Mr LAD to access your camera to take photos, scan business cards, and capture profile images.",
        "NSMicrophoneUsageDescription": "Allow Mr LAD to access your microphone to record voice notes and engage in AI assistant voice interactions.",
        "NSPhotoLibraryUsageDescription": "Allow Mr LAD to access your photo library to attach images and documents to CRM leads and chat messages.",
        "NSPhotoLibraryAddUsageDescription": "Allow Mr LAD to save exported spreadsheets, reports, and media directly to your photo library.",
        "NSLocationWhenInUseUsageDescription": "Allow Mr LAD to access your location to attach geo-tags to client meetings, fieldwork logs, and chat updates.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Mr LAD to access your location to support background fieldwork tracking and team coordination.",
        "NSFaceIDUsageDescription": "Allow Mr LAD to use Face ID for fast and secure biometric authentication.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "audio",
          "fetch",
          "remote-notification"
        ]
      }
    },
    "android": {
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#79797A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.company.mrlad",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#79797A",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Mr LAD to use your location to share it in conversations and track fieldwork."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Mr LAD to access your microphone to record voice notes and make AI voice calls."
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "74ec5d7f-a68d-484f-a9b6-e86dd6754c7e"
      }
    },
    "owner": "davoodkhan",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/74ec5d7f-a68d-484f-a9b6-e86dd6754c7e"
    }
  }
}
